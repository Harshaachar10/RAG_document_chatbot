APP_NAME=Doctor Intelligence
APP_VERSION=1.0.0
API_PREFIX=/api/v1
DATA_MODE=identity
ANALYSIS_MODE=azure
# Directory containing 01_nppes_reference.csv … 08_call_notes_and_inquiries.csv
CSV_DIRECTORY=data
RUNTIME_DIRECTORY=data/runtime
DOCUMENTS_DIRECTORY=data/documents
MOCK_DIRECTORY=data/mock
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_TIMEOUT_SECONDS=45
AZURE_OPENAI_MAX_RETRIES=2
AZURE_OPENAI_MAX_CONCURRENCY=2
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DEMO_RUN_STEP_DELAY_MS=400
UPLOAD_DIRECTORY=data/uploads
UPLOAD_MAX_BYTES=20000000
UPLOAD_RETENTION_DAYS=90
UPLOAD_ALLOW_LLM_IMAGES=false
UPLOAD_OCR_ENABLED=true
